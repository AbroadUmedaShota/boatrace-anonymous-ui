{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "boatrace-evaluation-transfer/1"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "rank-evaluation-summary/1"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "HELD"
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "known_results": {
          "const": true
        },
        "new_holdout": {
          "const": false
        },
        "operational_eligible": {
          "const": false
        },
        "predictive_usefulness_established": {
          "const": false
        },
        "period": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 366
                }
              },
              "required": [
                "start",
                "end",
                "days"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "model_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_created_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_fitted_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "paired": {
          "type": "object",
          "properties": {
            "r3": {
              "$ref": "#/$defs/pair"
            },
            "market": {
              "$ref": "#/$defs/pair"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "invariants": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tolerance": {
                  "type": "number"
                },
                "compared_forecast_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "prefix_passed": {
                  "type": "boolean"
                },
                "stage_loss_passed": {
                  "type": "boolean"
                },
                "first_max_absolute_delta": {
                  "type": "number"
                },
                "second_max_absolute_delta": {
                  "type": "number"
                },
                "ordered_pair_max_absolute_delta": {
                  "type": "number"
                },
                "stage_log_loss_delta": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "tolerance",
                "compared_forecast_count",
                "prefix_passed",
                "stage_loss_passed",
                "first_max_absolute_delta",
                "second_max_absolute_delta",
                "ordered_pair_max_absolute_delta",
                "stage_log_loss_delta"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "reasons",
        "known_results",
        "new_holdout",
        "operational_eligible",
        "predictive_usefulness_established",
        "period",
        "model_sha256",
        "created_at",
        "model_created_at",
        "model_fitted_at",
        "paired",
        "invariants"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "AVAILABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "period": {
                "not": {
                  "type": "null"
                }
              },
              "model_sha256": {
                "not": {
                  "type": "null"
                }
              },
              "created_at": {
                "not": {
                  "type": "null"
                }
              },
              "model_created_at": {
                "not": {
                  "type": "null"
                }
              },
              "model_fitted_at": {
                "not": {
                  "type": "null"
                }
              },
              "invariants": {
                "not": {
                  "type": "null"
                }
              },
              "reasons": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "period": {
                "type": "null"
              },
              "model_sha256": {
                "type": "null"
              },
              "created_at": {
                "type": "null"
              },
              "model_created_at": {
                "type": "null"
              },
              "model_fitted_at": {
                "type": "null"
              },
              "invariants": {
                "type": "null"
              },
              "paired": {
                "maxProperties": 0,
                "type": "object"
              },
              "reasons": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "schema_version",
        "source_api",
        "source_refs",
        "classification",
        "cohort",
        "package"
      ],
      "properties": {
        "schema_version": {
          "const": "boatrace-evaluation-provenance/1"
        },
        "source_api": {
          "type": "object",
          "required": [
            "operation",
            "summary_sha256",
            "summary_json_utf8",
            "matched"
          ],
          "properties": {
            "operation": {
              "const": "/api/rank/evaluation/latest"
            },
            "summary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "summary_json_utf8": {
              "type": "string",
              "maxLength": 100000
            },
            "matched": {
              "const": true
            }
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "classification": {
          "type": "object",
          "required": [
            "known_results",
            "new_holdout"
          ],
          "properties": {
            "known_results": {
              "const": true
            },
            "new_holdout": {
              "const": false
            }
          }
        },
        "cohort": {
          "type": "object",
          "required": [
            "dates",
            "r3_count",
            "market_count"
          ],
          "properties": {
            "dates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 366,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "r3_count": {
              "type": "integer",
              "minimum": 0
            },
            "market_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "package": {
          "type": "object",
          "required": [
            "source_sha",
            "manifest_sha256"
          ],
          "properties": {
            "source_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "evaluation_id",
    "summary",
    "provenance"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "boatrace-evaluation-transfer/1",
  "$defs": {
    "metrics": {
      "type": "object",
      "properties": {
        "log_loss": {
          "type": "number"
        },
        "third_nll": {
          "type": "number"
        },
        "brier_sum": {
          "type": "number"
        },
        "top1": {
          "type": "number"
        }
      },
      "required": [
        "log_loss",
        "third_nll",
        "brier_sum",
        "top1"
      ],
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "models": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "propertyNames": {
            "enum": [
              "R3",
              "R5",
              "MARKET"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/metrics"
          }
        },
        "delta": {
          "$ref": "#/$defs/metrics"
        },
        "daily": {
          "type": "array",
          "maxItems": 366,
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "log_loss_delta": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "date",
              "count",
              "log_loss_delta"
            ],
            "additionalProperties": false
          }
        },
        "day_balanced_delta": {
          "type": "number"
        },
        "interval": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "includes_zero": {
              "type": "boolean"
            },
            "mean": {
              "type": "number"
            },
            "method": {
              "const": "DESCRIPTIVE_DAY_BOOTSTRAP"
            },
            "formal_significance_test": {
              "const": false
            }
          },
          "required": [
            "low",
            "high",
            "includes_zero",
            "mean",
            "method",
            "formal_significance_test"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "count",
        "models",
        "delta",
        "daily",
        "day_balanced_delta",
        "interval"
      ],
      "additionalProperties": false
    }
  }
}
